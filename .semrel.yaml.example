# yaml-language-server: $schema=https://registry.semrel.io/schemas/core/v1.json
# semrel configuration — https://semrel.io/guide/configuration/
#
# Run `semrel config init` to generate this file interactively.
# Run `semrel config validate` to check for errors.

# ─────────────────────────────────────────────────────────────
#  MVP — minimal config for a GitHub project on GitHub Actions
# ─────────────────────────────────────────────────────────────
schemaVersion: 1

branches:
  - name: main              # stable releases

tagPrefix: "v"

rules:
  - type: feat
    bump: minor
  - type: fix
    bump: patch
  - type: perf
    bump: patch
  - type: revert
    bump: patch
  # Breaking changes (feat! or BREAKING CHANGE: footer) always → major

plugins:
  - uses: condition-github-actions  # only release on GitHub Actions, not local
    phase: condition
  - uses: "@semrel/github"          # create GitHub Release + push tag
    phase: release
  - uses: generator-changelog-md    # generate/update CHANGELOG.md

# ─────────────────────────────────────────────────────────────
#  Optional — uncomment what you need
# ─────────────────────────────────────────────────────────────

# Pre-release channels (branches trigger versioned pre-releases)
# branches:
#   - name: main
#   - name: next        # → v1.2.3-next.1
#     prerelease: next
#   - name: beta        # → v1.2.3-beta.1
#     prerelease: beta

# Scope-based bump rules (e.g. for Renovate)
# rules:
#   - type: deps
#     scope: major
#     bump: major
#   - type: deps
#     scope: minor
#     bump: minor
#   - type: deps
#     scope: patch
#     bump: patch

# Other providers
# - uses: "@semrel/gitlab"   phase: release
# - uses: "@semrel/gitea"    phase: release
# - uses: "@semrel/git"      phase: release   # bare git tag + push

# Version file updaters
# - uses: updater-npm        # updates package.json
# - uses: updater-go         # updates internal/version/version.go
# - uses: updater-cargo      # updates Cargo.toml
# - uses: updater-docker     # updates Dockerfile ARG VERSION
# - uses: updater-helm       # updates Chart.yaml appVersion
# - uses: updater-maven      # updates pom.xml
# - uses: updater-gradle     # updates gradle.properties
# - uses: updater-python     # updates pyproject.toml / setup.py
# - uses: updater-nuget      # updates .csproj
# - uses: updater-terraform  # updates variables.tf

# Notification hooks
# - uses: hook-slack         phase: release
# - uses: hook-teams         phase: release
# - uses: hook-matrix        phase: release
# - uses: hook-email         phase: release
# - uses: hook-jira          phase: release

# Monorepo workspace
# workspace:
#   strategy: independent   # or: lockstep
#   packages:
#     - path: packages/api
#       tagPrefix: api@v
#     - path: packages/cli
#       tagPrefix: cli@v
#       dependsOn: [packages/api]

# Version ceiling (useful while in 0.x.x pre-release)
# version_ceiling: "1.0.0"
# ceiling_strategy: clamp    # clamp (default), skip, or error

# Changelog commit behaviour
# commit_changelog: true          # default: commit CHANGELOG.md before tagging
# tag_exists_strategy: update-changelog  # default
